{
  "project_name": "LootingTheLeviathan",
  "generic_harness_root": "../agent-harness",
  "worklog_dirs": {
    "codex": "docs/codex-worklog",
    "summary": "docs/agent-worklog"
  },
  "token_policy": {
    "raw_log_default": "avoid",
    "summary_first": true,
    "large_log_token_threshold": 8000
  },
  "validation_commands": [
    {
      "name": "ltl fast compile/source quality gate",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-compile-check.ps1",
      "required": false
    },
    {
      "name": "ltl consolidated quality gate",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-ltl-quality-gate.ps1 -SkipGodotContracts -SkipVisualContracts",
      "required": false
    }
  ],
  "manual_checks": [
    "For gameplay/UI changes, record the exact Godot scene or flow and observed result.",
    "For visual changes, attach or link screenshots under docs/evidence/ when available.",
    "If Godot cannot run, record the reason and the smallest alternative verification."
  ]
}
